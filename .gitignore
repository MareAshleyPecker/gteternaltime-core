# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
.claude
.kotlin
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
# JVM 崩溃重放日志（runData OOM 之类会落在工程根目录）
replay_pid*.log

# Common working directory
run

# Kotlin IDE
.kotlin/

# Runtime data
run-data/

# Generated resources (committed intentionally)
# src/generated/

# 反编译参考产物（例如 net/minecraft/server/level/ServerPlayer.java），只在本机看，不进仓库
net/

# 构建 / 数据生成的临时日志（排查用，不进仓库）
build-*.log
runData-*.txt

# 本机自用脚本（例如重算补丁哈希的维护脚本），不进公开仓
local/

