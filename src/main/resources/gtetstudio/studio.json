{
  // ─────────────────────────────────────────────────────────────────────────
  // gtetstudio · 工作室自己的配置文件（设计文档 §7.1「渲染上限与降级」）
  //
  // 首次运行由 mod 释放到 config/gtetstudio/studio.json，之后以**这个文件**为准。
  // 改完不用重启：进游戏敲 `/gtetstudio reload` 就会连它一起重读（`/gtetstudio limits` 看当前生效值）。
  // 它**不是**模型定义 —— 这个文件没有 id，不会也不该被当成模型索引（见 StudioLibrary）。
  //
  // 为什么不是 Forge 的 config：注册 ForgeConfigSpec 要在 mod 构造阶段加一行宿主代码，
  // 而设计原则是「配置属于 studio 包自己」，整包抽出去时不能把宿主的配置一起拖走。
  // 这份 JSON 复用 studio 已有的读盘 + 热重载管线，零宿主接线。
  //
  // 容错：缺字段 / 类型不对 / 值非法 / 整份不是 JSON —— 一律用内置默认值并打日志，不会炸。
  // 认不出的键也会警告一句（键名拼错时上限会静默失效，那比报错难查得多）。
  // ─────────────────────────────────────────────────────────────────────────

  // 配置格式版本（与模型 JSON 的 version 是两码事）
  "version": 1,

  // 总开关：false = 一台 studio 模型都不画（排查「是不是 studio 拖的」时用）
  "enabled": true,

  // 单模型三角形上限，**载入期**校验：超限的模型被拒绝载入，
  // 日志里说清「哪个文件、多少面、上限多少」。不静默削面。
  "maxTrianglesPerModel": 200000,

  // 视距默认值（格）。模型 JSON 里自己写了 viewDistance 的，以模型那份为准（JSON 覆盖 > 全局默认）；
  // 全局值只对那些没写 viewDistance 的模型生效。
  "defaultViewDistance": 256,

  // ── 以下三项**当前版本尚未生效**：键先留好，M5（同屏数量 / 总预算的降级）才会去读它们 ──
  // 它们现在只是被解析、被 `/gtetstudio limits` 打印出来，没有任何代码按它们改行为。

  // M5：同屏同时渲染的 studio 模型数上限（按距相机由近到远保留前 N 个）
  "maxVisibleModels": 16,

  // M5：所有可见模型的三角形总预算
  "maxTotalTriangles": 800000,

  // M5：超过这个距离只画静态合并部件（跳过动态部件）
  "animationMaxDistance": 64
}
