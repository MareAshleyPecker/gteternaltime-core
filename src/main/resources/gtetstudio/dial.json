// ════════════════════════════════════════════════════════════════════════════
//  机器渲染工作室（studio）· M3a 示例定义 —— 「镂空表盘（CAD 参数化历史）」
//
//  ★ 这份 JSON 里**没有模型文件**：形状是一段"配方"算出来的。
//    改下面任何一个数字 → 敲一次 /gtetstudio reload → 形状立刻跟着变。
//
//  文件位置  config/gtetstudio/dial.json
//    首次运行时由 mod 自动释放（与 clock.json 同一套机制，之后以这个文件为准）
//
//  单位约定：1 单位 = 1 格；表盘在 **XY 平面**、**+Z 是正面**（与 OBJ 那套逐字一致）。
// ════════════════════════════════════════════════════════════════════════════
{
  "version": 1,

  // 模型 id —— 机器那边引用的就是它（机器模型 JSON 的 dynamic_renders[].model）。
  // ⚠️ 是 id 不是文件名：文件名随便叫，只有这个字段决定"谁是谁"。
  "id": "gtet:test_dial",

  // ══════════════════════════════════════════════════════════════════════════
  //  ★ M3a 的核心：features（CAD 参数化历史）
  //
  //  这是一段**按顺序重放的配方**，不是烘好的网格：
  //    · 每条特征只能引用**排在它前面**的特征（自引用 / 成环 / 引用后面的，都会在载入期报错）
  //    · 只有 extrude 产出几何，它的 name 就是**组名**（"齿轮单独转"靠的就是这个组名）
  //    · 2D 特征（圆/矩形/多边形/圆环/布尔/阵列）只产出"轮廓"，本身不产生任何面
  //
  //  与 source 的关系（只有一套逻辑，不会两套打架）：
  //    features 非空 ⇒ 用特征生成网格，**忽略** source.file / source.model
  //    features 为空 ⇒ 走原来的 OBJ 路径，source 必填
  //  所以这份文件里**故意不写 source 段**。
  //
  //  ── 可用的 type 与它们的字段 ────────────────────────────────────────────
  //    circle    { r, segments?, at? }                    圆（segments 默认 64，范围 3..512）
  //    rect      { w, h, at? }                            矩形（**at 是中心**）
  //    polygon   { points: [[x,y],...], at? }             多边形（至少 3 个点）
  //    ring      { rOuter, rInner, segments?, at? }       圆环（= 外圆 + 内孔，不用手写布尔）
  //    union / subtract / intersect { a, b }              布尔，a / b 是前面特征的名字
  //    array     { of, count, radius, axis?, startDeg?, sweepDeg? }   圆周阵列
  //    extrude   { of, thickness, centerZ?, material? }   沿 +Z 挤出成体（唯一产几何的）
  //
  //  at 是图元的**局部原点**：圆 = 圆心、矩形 = 中心、多边形 = points 坐标的偏移。省略 = [0,0]。
  //  array 的副本：第 i 个 = 绕原点转 (startDeg + i×sweepDeg/count) 度，并推到半径 radius 处。
  //                sweepDeg 是**总张角**、右端不闭合 ⇒ 360 度正好 count 个互不重合。
  //
  //  ⚠️ M3a 是 **2.5D**：只有"平板件"这条线（轮廓 → 布尔 → 挤出）。
  //     球体、3D 布尔、旋转体都没有 —— 那是 M3b/M7，别在这里找。
  // ══════════════════════════════════════════════════════════════════════════
  "features": [
    // ① 外轮廓：直径 9 格的大圆。segments 给到 96 是为了边缘够圆（96 段 ≈ 每段 0.29 格）
    { "type": "circle", "name": "outline", "r": 4.5, "segments": 96 },

    // ② 中心轴孔：半径 0.9
    { "type": "circle", "name": "centerHole", "r": 0.9, "segments": 32, "at": [0, 0] },

    // ③ 一个辐条孔的"样板"：以后要阵列的就是它
    { "type": "circle", "name": "spokeHole", "r": 0.45, "segments": 16 },

    // ④ 把样板绕原点阵列 12 份，分布在半径 3.15 的圆上（步距 = 360/12 = 30 度）
    //    → 这就是"改一个 count 就能变成 8 辐条 / 24 辐条"的那个数字
    {
      "type": "array",
      "name": "spokes",
      "of": "spokeHole",
      "count": 12,
      "radius": 3.15,
      "axis": "z",          // M3a 只支持 z（在 XY 平面内复制）
      "startDeg": 0,
      "sweepDeg": 360
    },

    // ⑤ 把"中心孔 + 12 个辐条孔"合成一整块挖空区（一次布尔，比逐个减更省）
    { "type": "union", "name": "holes", "a": "centerHole", "b": "spokes" },

    // ⑥ 从外轮廓上把挖空区减掉 —— ★「镂空」就是这一步
    //    想看看不减会怎样：把下面这行改成 union，reload 之后就得到一块实心圆盘
    { "type": "subtract", "name": "hollowed", "a": "outline", "b": "holes" },

    // ⑦ 沿 +Z 挤出 1 格厚。**组名 = "dial"**，所以动画轨道按 "dial" 就能让整块盘单独转。
    //    centerZ=true（默认）= 以 Z=0 为中心（实体落在 -0.5 ~ +0.5）；
    //    改成 false 就从 Z=0 往上长（0 ~ 1）—— 改完 reload 立刻能看到它整块前后挪。
    {
      "type": "extrude",
      "name": "dial",
      "of": "hollowed",
      "thickness": 1.0,
      "centerZ": true,
      "material": "frame"
    }
  ],

  // ── 材质 → 渲染方式 + 贴图 ──────────────────────────────────────────────
  //  ★ CAD（features）路径**没有 MTL**，所以贴图必须写在这里的 texture 上。
  //    （OBJ 路径的贴图仍然只来自 MTL 的 map_Kd，两条路不混。）
  //    render: cutout = alpha 剪裁、双面（镂空结构就该用它）；eyes = 全亮；translucent = 半透明
  "materials": {
    "frame": {
      "render": "cutout",
      "texture": "gtetcore:block/coil/testcoil/machine_coil_cupronickel"
    }
  },

  // ── 部件（= 组名）────────────────────────────────────────────────────────
  //  CAD 模型的组名就是每条 extrude 的 name。这里列出的名字**必须真的存在**，
  //  否则载入直接报错并列出可用组名（不静默）。
  "parts": [
    { "name": "dial" }
  ],

  // ── 挂到宿主上的哪一面、怎么摆 ─────────────────────────────────────────
  //  offset 在**面坐标系**里施加：+X 面内向右、+Y 面内向上、+Z 沿法线朝外。
  //  ★ 这里特意放到右边 5 格：测试机上同时挂着时钟（clock.json，在 [0,1,0]）与这块表盘，
  //    两者并排，方便一眼对照"新东西出来了没有"。想让它们重合就把 offset 改回 [0,1,0]。
  //  scale 0.5：表盘外径 9 格 → 场上 4.5 格，正好压在 3×3×3 的测试机上。
  "anchor": {
    "mode": "machine",
    "face": "front",
    "offset": [5, 1, 0],
    "scale": 0.5
  },

  // ── 动画（可选）────────────────────────────────────────────────────────
  //  这里给整块表盘配一条匀速自转，示范「组名 = feature 名 ⇒ 按组名单独动」这条路：
  //  换一个 extrude 的名字（比如下面那条 features[6].name 改成 "gear1"），
  //  再把这里的 part 一起改掉，就能让**另一个零件**转，别处一行都不用动。
  //  speed 单位：度 / 秒。24 度/秒 = 15 秒一圈（一眼看得出在转）。
  "animation": {
    "driver": "gameTime",
    "tracks": [
      {
        "part": "dial",
        "channel": "rot",
        "axis": "z",
        "speed": 24.0
      }
    ]
  }
}
