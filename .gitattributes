# 换行策略：仓库内一律以 LF 存储，工作区 EOL 由各平台自行决定。
# 这样 Windows 与 Linux 之间不会互相产生「整文件换行 diff」。
* text=auto

# 批处理脚本：不论谁克隆，工作区都给 CRLF（cmd 对 LF 的兼容性不保证）。
*.bat text eol=crlf

# shell 脚本：不论谁克隆，工作区都给 LF。checkout 成 CRLF 会让 shebang 变成
# "#!/usr/bin/env bash\r"，在 Linux/macOS 上直接报 bad interpreter，脚本根本跑不起来。
*.sh text eol=lf

# 二进制资源：禁止换行转换与文本 diff。
*.jar   binary
*.zip   binary
*.png   binary
*.ogg   binary
*.ttf   binary
*.otf   binary
*.psd   binary
*.xcf   binary
*.pdf   binary
